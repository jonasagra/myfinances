<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MyFinances.App.Views.FinanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" AllowDrop="True" xmlns:views="clr-namespace:MyFinances.App.Views;assembly=MyFinances" PreviewDragOver="Root_PreviewDragOver" DragOver="Root_DragOver" Drop="Root_Drop">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="MenuStyle" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      </Style>
      <DataTemplate x:Key="TablePanel">
        <Border Padding="0" Margin="0,0,12,12" ClipToBounds="True" AllowDrop="True" Style="{StaticResource Card}" DragEnter="Panel_DragOver" DragOver="Panel_DragOver" DragLeave="Panel_DragLeave" Drop="Panel_Drop">
          <DockPanel>
            <DockPanel Dock="Top" Margin="14,8,8,8">
              <Button DockPanel.Dock="Right" Margin="0" Padding="0" Width="30" Height="30" Command="{Binding DataContext.NewCommand, ElementName=Root}" CommandParameter="{Binding KindKey}" ToolTip="{Binding AddTip}">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
              </Button>
              <TextBlock DockPanel.Dock="Right" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,12,0" Text="{Binding ShownTotal, Converter={StaticResource Currency}}" ToolTip="{Binding ShownTotalTip}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsSelectionTotal}">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
              <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
            </DockPanel>
            <Grid>
              <DataGrid Name="grid" BorderThickness="0,1,0,0" MinHeight="120" SelectionMode="Extended" ItemsSource="{Binding Rows}" SelectedItem="{Binding DataContext.Selected, ElementName=Root, Mode=TwoWay}" MouseDoubleClick="Grid_MouseDoubleClick" PreviewKeyDown="Grid_PreviewKeyDown" PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown" PreviewMouseMove="Grid_PreviewMouseMove" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.RowStyle>
                  <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="FrameworkElement.ToolTip" Value="{Binding Hint}" />
                    <Setter Property="ToolTipService.InitialShowDelay" Value="900" />
                    <Setter Property="FrameworkElement.Tag" Value="{Binding DataContext, ElementName=Root}" />
                    <Setter Property="FrameworkElement.ContextMenu">
                      <Setter.Value>
                        <ContextMenu>
                          <MenuItem Header="Editar lançamento" Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                          <MenuItem Header="Excluir deste mês" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Header="Copiar" InputGestureText="Ctrl+C" Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                          <MenuItem Header="Recortar" InputGestureText="Ctrl+X" Command="{Binding PlacementTarget.Tag.CutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                          <MenuItem Header="Colar neste mês" InputGestureText="Ctrl+V" Command="{Binding PlacementTarget.Tag.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Visibility="{Binding PlacementTarget.Tag.CanPaste, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisible}}" />
                          <Separator />
                          <MenuItem InputGestureText="Ctrl+M" Header="{Binding MergeTwinsText}" Command="{Binding PlacementTarget.Tag.MergeTwinsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Visibility="{Binding HasTwins, Converter={StaticResource BoolToVisible}}" />
                          <MenuItem InputGestureText="Ctrl+M" Header="{Binding PlacementTarget.Tag.MergeSelectedText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding PlacementTarget.Tag.MergeSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Visibility="{Binding PlacementTarget.Tag.CanMergeSelected, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisible}}" />
                          <Separator />
                          <MenuItem Header="Desfazer o grupo inteiro (todas as linhas lançadas juntas)" Command="{Binding PlacementTarget.Tag.UndoGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        </ContextMenu>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsCut}">
                        <Setter Property="UIElement.Opacity" Value="0.4" />
                      </DataTrigger>
                      <DataTrigger Value="True" Binding="{Binding Fixed}">
                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Lançamento" SortMemberPath="Description" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                      <Condition Value="True" Binding="{Binding CanEdit}" />
                                      <Condition Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                  </MultiDataTrigger>
                                  <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                      <Condition Value="True" Binding="{Binding CanEdit}" />
                                      <Condition Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                  </MultiDataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                            <Button Content="" ToolTip="Editar" Style="{StaticResource IconButton}" Command="{Binding DataContext.EditCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Content="" ToolTip="Excluir deste mês" Style="{StaticResource IconButton}" Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button ToolTip="Selecionar" Style="{StaticResource IconButton}" PreviewMouseLeftButtonDown="RowCheck_PreviewMouseDown" Click="RowCheck_Click">
                              <Grid Width="14" Height="14">
                                <Viewbox>
                                  <Path StrokeThickness="2" Data="{StaticResource Icon.Box}" Style="{StaticResource IconPath}" />
                                </Viewbox>
                                <Viewbox Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource BoolToVisible}}">
                                  <Path StrokeThickness="3" Data="{StaticResource Icon.Check}" Style="{StaticResource IconPath}" />
                                </Viewbox>
                              </Grid>
                            </Button>
                          </StackPanel>
                          <TextBlock DockPanel.Dock="Left" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding ShowLock, Converter={StaticResource BoolToVisible}}">
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Value="True" Binding="{Binding Recurring}">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                  </DataTrigger>
                                  <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                      <Condition Value="True" Binding="{Binding Recurring}" />
                                      <Condition Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                  </MultiDataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </TextBlock>
                          <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Description}" />
                        </DockPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Valor" SortMemberPath="Amount" Width="115" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Amount, Converter={StaticResource Currency}}" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </DockPanel>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="28,20,16,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,12,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="‹ Anterior" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousCommand}" />
        <Button Content="Mês atual" Style="{StaticResource SecondaryButton}" Command="{Binding TodayCommand}" />
        <Button Content="Próximo ›" Style="{StaticResource SecondaryButton}" Margin="0" Command="{Binding NextCommand}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" FontSize="28" Margin="0" Text="{Binding MonthText}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,2,0,0" Text="{Binding Payslip}" />
      </StackPanel>
    </DockPanel>
    <TextBlock Grid.Row="1" Text="Tabelas legais deste ano ainda não cadastradas: valores calculados com as do ano anterior (estimativa)." Style="{StaticResource WarningText}" Visibility="{Binding Data.EstimatedParameters, Converter={StaticResource BoolToVisible}}" />
    <UniformGrid Grid.Row="2" Rows="1">
      <Border Style="{StaticResource StatCard}" MinWidth="0">
        <StackPanel>
          <TextBlock Text="Salário base" Style="{StaticResource FieldLabel}" />
          <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Data.Salary, Converter={StaticResource Currency}}" />
          <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{Binding SalarySource}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatCard}" MinWidth="0">
        <StackPanel>
          <TextBlock Text="Bruto" Style="{StaticResource FieldLabel}" />
          <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Data.Payroll.Gross, Converter={StaticResource Currency}}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatCard}" MinWidth="0">
        <StackPanel>
          <TextBlock Text="Líquido a receber" Style="{StaticResource FieldLabel}" />
          <TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource SuccessBrush}" Text="{Binding Data.Payroll.Net, Converter={StaticResource Currency}}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatCard}" MinWidth="0">
        <StackPanel>
          <TextBlock Text="Sobra só deste mês" Style="{StaticResource FieldLabel}" />
          <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Data.Summary.MonthBalanceWith13th, Converter={StaticResource Currency}}" Foreground="{Binding Data.Summary.MonthBalanceWith13th, Converter={StaticResource SignColor}}" />
          <TextBlock Text="o que este mês rende sozinho" Style="{StaticResource Hint}" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatCard}" MinWidth="0" BorderBrush="{StaticResource AccentHoverBrush}">
        <StackPanel>
          <TextBlock Text="Na conta no fim do mês" Style="{StaticResource FieldLabel}" />
          <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Data.Summary.RemainingWith13th, Converter={StaticResource Currency}}" Foreground="{Binding Data.Summary.RemainingWith13th, Converter={StaticResource SignColor}}" />
          <Button Content="Conferir com o saldo real" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,2,0,0" Padding="6,2" ToolTip="Diga quanto tem na conta e o app lança a diferença como ajuste" Command="{Binding AdjustBalanceCommand}" />
        </StackPanel>
      </Border>
    </UniformGrid>
    <Expander Grid.Row="3" Margin="0,0,12,10" Header="{Binding SalaryHeader}">
      <Border Style="{StaticResource Card}" Margin="0,8,0,0">
        <WrapPanel>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Text="Salário base deste mês" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal">
              <TextBox Width="130" Text="{Binding Salary, UpdateSourceTrigger=PropertyChanged}" />
              <Button Content="Salvar" Margin="8,0,0,0" Command="{Binding SaveSalaryCommand}" />
              <Button Content="Repetir anterior" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding RepeatSalaryCommand}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Text="Faltas  ·  repousos perdidos (DSR)  ·  horas de atraso (7:17 ou 7,28)" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal">
              <TextBox Width="70" ToolTip="Dias de falta/suspensão" Text="{Binding AbsenceDays, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Width="70" Margin="8,0,0,0" ToolTip="Repousos semanais perdidos (DSR)" Text="{Binding Dsr, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Width="90" Margin="8,0,0,0" ToolTip="Horas de atraso: 7:17 ou 7,28" Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}" />
              <Button Content="Salvar faltas" Margin="8,0,0,0" Command="{Binding SaveAbsencesCommand}" />
            </StackPanel>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Observação do mês (salva junto com o salário)" Style="{StaticResource FieldLabel}" />
            <TextBox MaxLength="300" Width="320" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </WrapPanel>
      </Border>
    </Expander>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,12,12">
      <TextBox Style="{StaticResource SearchBox}" Tag="Buscar neste mês" Width="300" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Search_PreviewKeyDown" />
      <Button Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0" Margin="10,0,0,0" ToolTip="Lê o PDF do contracheque (ou solte o arquivo nesta tela)" Command="{Binding ImportPayslipCommand}">
        <StackPanel Orientation="Horizontal">
          <Viewbox Width="16" Height="16" Margin="0,0,8,0">
            <Path Data="{StaticResource Icon.Sheet}" Style="{StaticResource IconPath}" />
          </Viewbox>
          <TextBlock Text="Importar contracheque" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0" Margin="8,0,0,0" ToolTip="Como o bruto, o INSS, o IRRF e o líquido deste mês foram calculados" Command="{Binding BreakdownCommand}">
        <StackPanel Orientation="Horizontal">
          <Viewbox Width="16" Height="16" Margin="0,0,8,0">
            <Path Data="{StaticResource Icon.Receipt}" Style="{StaticResource IconPath}" />
          </Viewbox>
          <TextBlock Text="Memória de cálculo" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
    <Border Grid.Row="5" Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,12,28" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16,6,6,6" Visibility="{Binding Toast, Converter={StaticResource BoolToVisible}}">
      <UIElement.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" />
      </UIElement.Effect>
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" MaxWidth="520" TextTrimming="CharacterEllipsis" Text="{Binding Toast}" />
        <Button Content="Desfazer" Style="{StaticResource LinkButton}" Margin="14,0,0,0" ToolTip="Ctrl+Z" Command="{Binding UndoCommand}" Visibility="{Binding ToastCanUndo, Converter={StaticResource BoolToVisible}}" />
      </StackPanel>
    </Border>
    <ItemsControl Name="TablesHost" Grid.Row="5" ItemTemplate="{StaticResource TablePanel}" ItemsSource="{Binding Tables}" SizeChanged="TablesHost_SizeChanged">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </Grid>
</UserControl>