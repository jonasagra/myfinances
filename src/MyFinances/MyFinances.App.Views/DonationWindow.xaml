<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MyFinances.App.Views.DonationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Apoiar o MyFinances" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{StaticResource DarkWindow}" ShowInTaskbar="False" xmlns:views="clr-namespace:MyFinances.App.Views;assembly=MyFinances">
  <StackPanel Margin="24">
    <TextBlock Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
    <TextBlock Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16" />
    <Border Name="PixPanel" Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Chave Pix" Style="{StaticResource FieldLabel}" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Copiar" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="CopyPix_Click" />
          <TextBox Name="PixText" IsReadOnly="True" Margin="0" />
        </DockPanel>
      </StackPanel>
    </Border>
    <Border Name="LinkPanel" Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Link de doação" Style="{StaticResource FieldLabel}" />
        <TextBlock Name="LinkText" TextWrapping="Wrap" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,8" />
        <Image Name="QrImage" Width="180" Height="180" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <Button Name="OpenLink" Content="Abrir no navegador" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenLink_Click" />
      </StackPanel>
    </Border>
    <TextBlock Name="OfflineText" Style="{StaticResource WarningText}" Visibility="Collapsed" Text="Sem conexão agora: o link e o QR aparecem quando houver internet. Tudo no MyFinances continua funcionando normalmente." />
    <TextBlock Name="NoInfoPanel" Style="{StaticResource Hint}" Visibility="Collapsed" Text="As informações de doação ainda não foram configuradas." />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Não mostrar por 30 dias" Style="{StaticResource SecondaryButton}" Click="Snooze_Click" />
      <Button Content="Fechar" IsDefault="True" IsCancel="True" Margin="0" Click="Close_Click" />
    </StackPanel>
  </StackPanel>
</Window>