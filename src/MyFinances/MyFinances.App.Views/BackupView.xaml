<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MyFinances.App.Views.BackupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MyFinances.App.Views;assembly=MyFinances">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22" MaxWidth="1000" HorizontalAlignment="Left">
      <TextBlock Text="Backup e restauração" Style="{StaticResource PageTitle}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Backup portátil (.mfbak, com senha)" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
          <TextBlock Text="Banco, documentos e chave, protegidos por senha. Serve para levar a outro computador." Style="{StaticResource Hint}" Margin="0,0,0,10" />
          <WrapPanel>
            <Button Content="Criar backup portátil..." Command="{Binding CreateCommand}" />
            <Button Content="Restaurar de um arquivo..." Style="{StaticResource SecondaryButton}" Command="{Binding RestoreFileCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Backups automáticos" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
          <TextBlock Text="Uma vez por dia e antes de cada atualização. Só restauram neste Windows." Style="{StaticResource Hint}" Margin="0,0,0,10" />
          <DataGrid Height="220" ItemsSource="{Binding Automatic}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Arquivo" Width="*" Binding="{Binding Name}" />
              <DataGridTextColumn Header="Data" Width="150" Binding="{Binding Data, Converter={StaticResource DateText}}" />
              <DataGridTextColumn Header="Tamanho" Width="90" Binding="{Binding Size}" />
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,10,0,0">
            <Button Content="Restaurar o selecionado" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreSelectedCommand}" />
            <Button Content="Fazer backup automático agora" Style="{StaticResource SecondaryButton}" Command="{Binding CreateAutoNowCommand}" />
            <Button Content="Abrir pasta de dados" Style="{StaticResource LinkButton}" Command="{Binding OpenFolderCommand}" />
          </WrapPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,0">
            <Run Text="Pasta de dados:" /> <Run Text="{Binding DataFolder, Mode=OneWay}" /></TextBlock>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <TextBlock TextWrapping="Wrap" Text="{Binding Instructions}" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>