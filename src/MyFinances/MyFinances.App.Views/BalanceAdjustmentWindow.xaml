<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MyFinances.App.Views.BalanceAdjustmentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Conferir com o saldo real" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{StaticResource DarkWindow}" ShowInTaskbar="False" xmlns:views="clr-namespace:MyFinances.App.Views;assembly=MyFinances">
  <StackPanel Margin="20">
    <TextBlock Name="Header" TextWrapping="Wrap" Margin="0,0,0,12" />
    <TextBlock Text="Quanto você tem na conta agora (R$)" Style="{StaticResource FieldLabel}" />
    <TextBox Name="RealBalanceBox" TextChanged="Field_TextChanged" />
    <TextBlock Text="Já lançado neste mês, mas ainda NÃO entrou na conta (R$)" Style="{StaticResource FieldLabel}" />
    <TextBox Name="PendingInflowBox" Text="0" TextChanged="Field_TextChanged" />
    <TextBlock Text="Ex.: um crédito que ainda não caiu." Style="{StaticResource Hint}" Margin="0,-6,0,10" />
    <TextBlock Text="Já lançado neste mês, mas ainda NÃO saiu da conta (R$)" Style="{StaticResource FieldLabel}" />
    <TextBox Name="PendingOutflowBox" Text="0" TextChanged="Field_TextChanged" />
    <TextBlock Text="Ex.: uma conta que vence no fim do mês." Style="{StaticResource Hint}" Margin="0,-6,0,10" />
    <TextBox Name="Preview" Style="{StaticResource BreakdownBox}" Height="130" Margin="0,4,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" />
      <Button Name="Apply" Content="Lançar ajuste" IsDefault="True" Margin="0" Click="Apply_Click" />
    </StackPanel>
  </StackPanel>
</Window>