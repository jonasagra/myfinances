<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MyFinances.App.Views.PinWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MyFinances" Width="360" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Style="{StaticResource DarkWindow}" Icon="/Resources/myfinances.ico" xmlns:views="clr-namespace:MyFinances.App.Views;assembly=MyFinances">
  <StackPanel Margin="24">
    <Image Source="/Resources/logo.png" Width="56" Height="56" Margin="0,0,0,12" />
    <TextBlock Text="Digite seu PIN" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12" />
    <PasswordBox Name="PinBox" FontSize="18" HorizontalContentAlignment="Center" MaxLength="12" />
    <TextBlock Name="Message" Style="{StaticResource ErrorText}" HorizontalAlignment="Center" />
    <Button Content="Entrar" IsDefault="True" Margin="0,4,0,0" Click="Enter_Click" />
    <TextBlock Text="Esqueceu o PIN? Veja &quot;PIN&quot; no README (opção --reset-pin)." Style="{StaticResource Hint}" Margin="0,14,0,0" />
  </StackPanel>
</Window>