<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MyFinances.App.Views.PayslipImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Importar contracheque" Width="760" Height="680" MinHeight="480" MinWidth="620" WindowStartupLocation="CenterOwner" Style="{StaticResource DarkWindow}" ShowInTaskbar="False" xmlns:views="clr-namespace:MyFinances.App.Views;assembly=MyFinances">
  <DockPanel Margin="22">
    <DockPanel Dock="Top" Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
        <TextBlock Text="Lançar em (mm/aaaa)" Style="{StaticResource FieldLabel}" />
        <TextBox Width="120" Margin="0" Text="{Binding Month, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" FontSize="22" Margin="0" Text="{Binding Title}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,2,0,0">
          <Run Text="{Binding PaidText, Mode=OneWay}" />
          <Run Text="  ·  " />
          <Run Text="{Binding FileName, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </DockPanel>
    <DockPanel Dock="Bottom" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" />
        <Button Content="Importar" IsDefault="True" Margin="0" Click="Import_Click" />
      </StackPanel>
      <TextBlock Style="{StaticResource ErrorText}" VerticalAlignment="Center" Text="{Binding Error}" />
    </DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0" Text="{Binding NetDifference}" />
          <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" FontSize="16" VerticalAlignment="Center" Visibility="{Binding NetMatches, Converter={StaticResource BoolToVisible}}" />
        </StackPanel>
        <TextBlock VerticalAlignment="Center" FontSize="14.5">
          <Run Text="Líquido no contracheque" Foreground="{StaticResource MutedTextBrush}" /> <Run FontWeight="SemiBold" Text="{Binding PayslipNet, Converter={StaticResource Currency}, Mode=OneWay}" /> <Run Text="   ·   no app" Foreground="{StaticResource MutedTextBrush}" /> <Run FontWeight="SemiBold" Text="{Binding AppNet, Converter={StaticResource Currency}, Mode=OneWay}" /></TextBlock>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
      <StackPanel>
        <CheckBox Margin="0,0,0,6" Content="{Binding SalaryText}" IsChecked="{Binding UpdateSalary}" Visibility="{Binding SalaryDiffers, Converter={StaticResource BoolToVisible}}" />
        <CheckBox Margin="0,0,0,8" Content="{Binding AbsencesText}" IsChecked="{Binding FillAbsences}" Visibility="{Binding AbsencesDiffer, Converter={StaticResource BoolToVisible}}" />
        <ItemsControl ItemsSource="{Binding Checks}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,2,22,2" ToolTip="Calculado pelo app (contracheque · app)">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock VerticalAlignment="Center">
                  <Run Foreground="{StaticResource MutedTextBrush}" Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding Payslip, Converter={StaticResource Currency}, Mode=OneWay}" /></TextBlock>
                <TextBlock Text=" ✓" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Visibility="{Binding Matches, Converter={StaticResource BoolToVisible}}" />
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" Visibility="{Binding Matches, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                  <Run Text="  app" /> <Run Text="{Binding App, Converter={StaticResource Currency}, Mode=OneWay}" /></TextBlock>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <DataGrid IsReadOnly="False" SelectionMode="Single" ItemsSource="{Binding Rows}">
      <DataGrid.Columns>
        <DataGridTemplateColumn Width="40" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Tabela" Width="90" IsReadOnly="True" Binding="{Binding Table}" />
        <DataGridTextColumn Header="Lançamento" Width="*" IsReadOnly="True" Binding="{Binding Name}" />
        <DataGridTextColumn Header="Valor" SortMemberPath="Amount" Width="110" IsReadOnly="True" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Amount, Converter={StaticResource Currency}}" />
        <DataGridTextColumn Width="120" IsReadOnly="True" Binding="{Binding Status}">
          <DataGridBoundColumn.ElementStyle>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
              <Setter Property="FontSize" Value="12" />
            </Style>
          </DataGridBoundColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>