<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MyFinances.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MyFinances.App.Views;assembly=MyFinances">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22">
      <TextBlock Text="Painel" Style="{StaticResource PageTitle}" />
      <WrapPanel Margin="0,0,0,8">
        <StackPanel Margin="0,0,10,0">
          <TextBlock Text="De (mm/aaaa)" Style="{StaticResource FieldLabel}" />
          <TextBox Width="110" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Margin="0,0,10,0">
          <TextBlock Text="Até (mm/aaaa)" Style="{StaticResource FieldLabel}" />
          <TextBox Width="110" Text="{Binding Until, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <Button Content="Atualizar" VerticalAlignment="Center" Margin="0,8,8,0" Command="{Binding RefreshCommand}" />
        <Button Content="Este ano" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="0,8,8,0" Command="{Binding ThisYearCommand}" />
        <Button Content="Próximos 12 meses" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="0,8,8,0" Command="{Binding Next12Command}" />
        <Button Content="Tudo" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="0,8,24,0" Command="{Binding AllCommand}" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
          <RadioButton Content="Com 13º" GroupName="cen13" Style="{StaticResource ToggleOption}" IsChecked="{Binding With13th}" />
          <RadioButton Content="Sem 13º" GroupName="cen13" Style="{StaticResource ToggleOption}" IsChecked="{Binding Without13th}" />
        </StackPanel>
      </WrapPanel>
      <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource BoolToVisible}}" />
      <Border Background="{StaticResource Surface3Brush}" CornerRadius="8" Padding="12,8" Margin="0,4,12,14" HorizontalAlignment="Left">
        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentLightBrush}" Text="{Binding ScenarioText}" />
      </Border>
      <TextBlock Style="{StaticResource WarningText}" Text="{Binding ParametersWarning}" Visibility="{Binding ParametersWarning, Converter={StaticResource BoolToVisible}}" />
      <TextBlock Text="Finanças pessoais" Style="{StaticResource SectionTitle}" />
      <WrapPanel>
        <Border Style="{StaticResource StatCard}" BorderBrush="{StaticResource AccentHoverBrush}">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding CurrentLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding CurrentRemaining, Converter={StaticResource Currency}}" Foreground="{Binding CurrentRemaining, Converter={StaticResource SignColor}}" />
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="170" Text="{Binding CurrentNote}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="Receitas (líquido + entradas)" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource SuccessBrush}" Text="{Binding Revenue, Converter={StaticResource Currency}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="Despesas" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource DangerBrush}" Text="{Binding Expenses, Converter={StaticResource Currency}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="Saldo do período" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Balance, Converter={StaticResource Currency}}" Foreground="{Binding Balance, Converter={StaticResource SignColor}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="Restante no fim do período" Style="{StaticResource FieldLabel}" MaxWidth="200" />
            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding FinalRemaining, Converter={StaticResource Currency}}" Foreground="{Binding FinalRemaining, Converter={StaticResource SignColor}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="Restante com 13º" Style="{StaticResource FieldLabel}" />
            <TextBlock FontSize="18" Text="{Binding FinalRemainingWith13th, Converter={StaticResource Currency}}" />
            <TextBlock Text="Restante sem 13º" Style="{StaticResource FieldLabel}" Margin="0,6,0,2" />
            <TextBlock FontSize="18" Text="{Binding FinalRemainingWithout13th, Converter={StaticResource Currency}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="13º no período (líquido)" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Total13th, Converter={StaticResource Currency}}" />
          </StackPanel>
        </Border>
      </WrapPanel>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Saldo de cada mês" Style="{StaticResource FieldLabel}" />
          <ItemsControl Height="150" Margin="0,8,0,0" ItemsSource="{Binding ChartMonths}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="58">
                  <Grid Height="114">
                    <Button Cursor="Hand" Focusable="False" VerticalAlignment="Bottom" HorizontalAlignment="Center" Command="{Binding DataContext.OpenMonthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                      <FrameworkElement.ToolTip>
                        <TextBlock>
                          <Run FontWeight="SemiBold" Text="{Binding Month, Mode=OneWay}" />
                          <LineBreak />
                          <Run Text="Saldo do mês:" /> <Run Text="{Binding Balance, Converter={StaticResource Currency}, Mode=OneWay}" /><LineBreak /><Run Text="Líquido:" /> <Run Text="{Binding Net, Converter={StaticResource Currency}, Mode=OneWay}" /><LineBreak /><Run Text="Entradas:" /> <Run Text="{Binding Inflows, Converter={StaticResource Currency}, Mode=OneWay}" /><LineBreak /><Run Text="Despesas:" /> <Run Text="{Binding Expenses, Converter={StaticResource Currency}, Mode=OneWay}" /><LineBreak /><Run Text="Restante:" /> <Run Text="{Binding Remaining, Converter={StaticResource Currency}, Mode=OneWay}" /></TextBlock>
                      </FrameworkElement.ToolTip>
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="bar" Width="30" Height="{Binding BarHeight}">
                            <FrameworkElement.Style>
                              <Style BasedOn="{StaticResource ChartBar}" TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Value="True" Binding="{Binding Negative}">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                  </DataTrigger>
                                  <DataTrigger Value="True" Binding="{Binding Future}">
                                    <Setter Property="UIElement.Opacity" Value="0.55" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="bar" Property="UIElement.Opacity" Value="1" />
                              <Setter TargetName="bar" Property="UIElement.Effect">
                                <Setter.Value>
                                  <DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0.35" />
                                </Setter.Value>
                              </Setter>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                  </Grid>
                  <TextBlock FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Month}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <DataGrid MaxHeight="460" Margin="0,0,12,12" ItemsSource="{Binding Months}" MouseDoubleClick="MonthsGrid_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Mês" SortMemberPath="Key" Width="100" Binding="{Binding Month}" />
          <DataGridTextColumn Header="Líquido" SortMemberPath="Net" Width="*" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Net, Converter={StaticResource Currency}}" />
          <DataGridTextColumn Header="Entradas" SortMemberPath="Inflows" Width="*" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Inflows, Converter={StaticResource Currency}}" />
          <DataGridTextColumn Header="13º" SortMemberPath="Thirteenth" Width="*" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Thirteenth, Converter={StaticResource Currency}}" />
          <DataGridTextColumn Header="Despesas" SortMemberPath="Expenses" Width="*" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Expenses, Converter={StaticResource Currency}}" />
          <DataGridTextColumn Header="Saldo do mês" SortMemberPath="Balance" Width="*" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Balance, Converter={StaticResource Currency}}" />
          <DataGridTextColumn Header="Restante (cenário ativo)" SortMemberPath="Remaining" Width="*" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding Remaining, Converter={StaticResource Currency}}" />
          <DataGridTextColumn Header="Restante (outro cenário)" SortMemberPath="RemainingOther" Width="*" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Binding="{Binding RemainingOther, Converter={StaticResource Currency}}" />
        </DataGrid.Columns>
      </DataGrid>
      <Expander Header="Como os números pessoais são calculados" Margin="0,0,12,12">
        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
          <TextBlock TextWrapping="Wrap" FontSize="12.5" Text="{Binding PersonalFormulas}" />
        </Border>
      </Expander>
      <TextBlock Text="Empréstimos a clientes" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
      <TextBlock Style="{StaticResource FieldLabel}">
        <Run Text="Posição em" /> <Run Text="{Binding LoanStats.Reference, Converter={StaticResource DateText}, Mode=OneWay}" /> <Run Text=" · contratos ativos:" /> <Run Text="{Binding LoanStats.ActiveLoans, Mode=OneWay}" /> <Run Text=" · em atraso:" /> <Run Text="{Binding LoanStats.LateLoans, Mode=OneWay}" /> <Run Text=" · inadimplentes:" /> <Run Text="{Binding LoanStats.AtRiskLoans, Mode=OneWay}" /></TextBlock>
      <WrapPanel Margin="0,8,0,0">
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="Capital emprestado no período" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding LoanStats.CapitalLentInPeriod, Converter={StaticResource Currency}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="Principal amortizado (recebido)" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding LoanStats.PrincipalAmortizedInPeriod, Converter={StaticResource Currency}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="Saldo devedor (principal)" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding LoanStats.PrincipalOwed, Converter={StaticResource Currency}}" />
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0">
              <Run Text="com juros e encargos:" /> <Run Text="{Binding LoanStats.TotalOwed, Converter={StaticResource Currency}, Mode=OneWay}" /></TextBlock>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}" BorderBrush="{StaticResource WarningBrush}">
          <StackPanel>
            <TextBlock Text="Vencido em aberto" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource WarningBrush}" Text="{Binding LoanStats.OverdueAmount, Converter={StaticResource Currency}}" />
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0">
              <Run Text="{Binding LoanStats.OverdueInstallments, Mode=OneWay}" /> <Run Text="parcela(s) vencida(s)" /></TextBlock>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="Juros previstos no período" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource InfoBrush}" Text="{Binding LoanStats.ExpectedInterestInPeriod, Converter={StaticResource Currency}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="Juros recebidos" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource SuccessBrush}" Text="{Binding LoanStats.InterestReceivedInPeriod, Converter={StaticResource Currency}}" />
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0">
              <Run Text="multa+mora:" /> <Run Text="{Binding LoanStats.ChargesReceivedInPeriod, Converter={StaticResource Currency}, Mode=OneWay}" /> <Run Text=" · tarifas:" /> <Run Text="{Binding LoanStats.FeesReceivedInPeriod, Converter={StaticResource Currency}, Mode=OneWay}" /></TextBlock>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}" BorderBrush="{StaticResource SuccessBrush}">
          <StackPanel>
            <TextBlock Text="Lucro realizado" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding LoanStats.RealizedProfit, Converter={StaticResource Currency}}" Foreground="{Binding LoanStats.RealizedProfit, Converter={StaticResource SignColor}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Text="Juros a receber" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding LoanStats.InterestReceivable, Converter={StaticResource Currency}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}" BorderBrush="{StaticResource DangerBrush}">
          <StackPanel>
            <TextBlock Text="Perda estimada (em risco)" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource DangerBrush}" Text="{Binding LoanStats.EstimatedLoss, Converter={StaticResource Currency}}" />
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0">
              <Run Text="baixado como perda:" /> <Run Text="{Binding LoanStats.WriteOffsInPeriod, Converter={StaticResource Currency}, Mode=OneWay}" /></TextBlock>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}" BorderBrush="{StaticResource AccentHoverBrush}">
          <StackPanel>
            <TextBlock Text="Lucro projetado" Style="{StaticResource FieldLabel}" />
            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding LoanStats.ProjectedProfit, Converter={StaticResource Currency}}" Foreground="{Binding LoanStats.ProjectedProfit, Converter={StaticResource SignColor}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}" Visibility="{Binding LoanStats.CapitalLimit, Converter={StaticResource BoolToVisible}}">
          <StackPanel>
            <TextBlock Text="Capital disponível (limite − principal em aberto)" Style="{StaticResource FieldLabel}" MaxWidth="200" />
            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding LoanStats.AvailableCapital, Converter={StaticResource Currency}}" />
          </StackPanel>
        </Border>
      </WrapPanel>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Juros por mês:" Style="{StaticResource FieldLabel}" />
            <Border Background="{StaticResource InfoBrush}" Width="12" Height="12" Margin="12,0,4,4" CornerRadius="2" />
            <TextBlock Text="previstos" Style="{StaticResource FieldLabel}" />
            <Border Background="{StaticResource SuccessBrush}" Width="12" Height="12" Margin="12,0,4,4" CornerRadius="2" />
            <TextBlock Text="recebidos (juros + encargos + tarifas)" Style="{StaticResource FieldLabel}" />
          </StackPanel>
          <ItemsControl Height="150" Margin="0,8,0,0" ItemsSource="{Binding LoanSeries}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="58">
                  <FrameworkElement.ToolTip>
                    <TextBlock>
                      <Run Text="Previsto:" /> <Run Text="{Binding Expected, Converter={StaticResource Currency}, Mode=OneWay}" /><LineBreak /><Run Text="Recebido:" /> <Run Text="{Binding Received, Converter={StaticResource Currency}, Mode=OneWay}" /></TextBlock>
                  </FrameworkElement.ToolTip>
                  <StackPanel Orientation="Horizontal" Height="124" HorizontalAlignment="Center">
                    <Border Style="{StaticResource ChartBar}" Width="14" Background="{StaticResource InfoBrush}" Height="{Binding ExpectedHeight}" />
                    <Border Style="{StaticResource ChartBar}" Width="14" Background="{StaticResource SuccessBrush}" Height="{Binding ReceivedHeight}" />
                  </StackPanel>
                  <TextBlock FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Month}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Como os números de empréstimos são calculados" Style="{StaticResource FieldLabel}" />
          <TextBlock TextWrapping="Wrap" FontSize="12.5" Text="{Binding LoanStats.Formulas}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>