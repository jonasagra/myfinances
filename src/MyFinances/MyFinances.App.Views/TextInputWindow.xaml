<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MyFinances.App.Views.TextInputWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MyFinances" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{StaticResource DarkWindow}" ShowInTaskbar="False" xmlns:views="clr-namespace:MyFinances.App.Views;assembly=MyFinances">
  <StackPanel Margin="20">
    <TextBlock Name="Question" TextWrapping="Wrap" Margin="0,0,0,12" />
    <TextBox Name="AnswerBox" />
    <PasswordBox Name="PasswordInput" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" />
      <Button Content="OK" IsDefault="True" Margin="0" Click="Ok_Click" />
    </StackPanel>
  </StackPanel>
</Window>