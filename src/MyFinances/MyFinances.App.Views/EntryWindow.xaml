<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MyFinances.App.Views.EntryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{StaticResource DarkWindow}" ShowInTaskbar="False" xmlns:views="clr-namespace:MyFinances.App.Views;assembly=MyFinances" Title="{Binding WindowTitle}">
  <StackPanel Margin="22">
    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding WindowTitle}" />
    <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}" />
    <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" />
    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Text="{Binding Hint}" />
    <TextBlock Text="Descrição" Style="{StaticResource FieldLabel}" />
    <TextBox MaxLength="200" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="12" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Foreground="{StaticResource AccentLightBrush}" FontWeight="SemiBold" Text="{Binding AmountResult}" />
          <TextBlock Text="Valor (R$)" Style="{StaticResource FieldLabel}" />
        </DockPanel>
        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Mês (mm/aaaa)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Month, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </Grid>
    <CheckBox Content="Lançamento fixo: repete todo mês, deste mês em diante" Margin="0,4,0,8" ToolTip="Para contas que se repetem (internet, assinatura...). Aparece com um cadeado roxo e continua editável." IsChecked="{Binding IsFixed}" />
    <StackPanel Visibility="{Binding ShowRepeat, Converter={StaticResource BoolToVisible}}">
      <TextBlock Text="Repetir por (meses)" Style="{StaticResource FieldLabel}" />
      <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding Repeat, UpdateSourceTrigger=PropertyChanged}" />
      <CheckBox Content="Compra parcelada: gravar como &quot;Nome 1/N&quot;, &quot;Nome 2/N&quot;..." IsChecked="{Binding Installments}" />
    </StackPanel>
    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" />
      <Button Content="Salvar" IsDefault="True" Margin="0" Click="Save_Click" />
    </StackPanel>
  </StackPanel>
</Window>